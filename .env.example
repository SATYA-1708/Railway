# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# Database Persistence (Dual Support: PostgreSQL or SQLite)
# PostgreSQL Production:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railflow
# SQLite Zero-Config Fallback:
# DATABASE_URL=sqlite:///./data/railflow.db

# JWT Authentication & RBAC Security
SECRET_KEY=railflow-super-secure-jwt-key-sih-2026-finals
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Twilio SMS / WhatsApp Alerts Gateway (Leave empty for Demo Sandbox Mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12058917263

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000
